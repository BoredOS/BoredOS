# Virtual consoles (tty1 - tty10)
tty1      "/bin/getty --autologin root 1"   ansi      on           respawn
tty2      "/bin/getty 2"      ansi      on           lazy
tty3      "/bin/getty 3"      ansi      on           lazy
tty4      "/bin/getty 4"      ansi      on           lazy
tty5      "/bin/getty 5"      ansi      off          off
tty6      "/bin/getty 6"      ansi      off          off
tty7      "/bin/getty 7"      ansi      off          off
tty8      "/bin/getty 8"      ansi      off          off
tty9      "/bin/getty 9"      ansi      off          off
tty10     "/bin/getty 10"     ansi      off          off

# Serial ports
ttyS0     "/bin/getty --autologin root 11"     vt100     on           respawn
ttyS1     "/bin/bsh 12"       vt100     off          off
ttyS2     "/bin/bsh 13"       vt100     off          off
ttyS3     "/bin/bsh 14"       vt100     off          off
